# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (canonical URLs, sitemap, Open Graph, and links in admin invites)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (leave empty to disable tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Supabase (content, team accounts, booking requests) -----------------------
# Dashboard > Project Settings > API. Without these the site uses the built-in demo content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET, server-only: never share, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (photo uploads from the admin) -----------------------------------
# Dashboard > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SECRET, server-only.
CLOUDINARY_API_SECRET=

# Optional, Vercel only: any long random string. Vercel then sends it with its daily call to
# /api/keep-alive (keeps the free Supabase project from pausing), and nobody else can call it.
# CRON_SECRET=

# --- Resend (emails: new-request alerts, team invites and reset links from the People page) ---
# SECRET, server-only. Without it nothing is emailed: requests still reach the inbox and the
# People page still gives links to copy. (Forgot password on the sign-in page goes through
# Supabase, which uses Resend via its SMTP settings: see docs/admin-setup.md.)
# RESEND_API_KEY=
# Who gets an email for each new trip request or contact message (comma-separated).
# Defaults to the contact email in Site settings.
# INQUIRY_ALERT_TO=
# Sender. Must be on a domain verified in Resend (tayariafrica.com).
# ALERT_FROM=Tayari Africa Tours <no-reply@tayariafrica.com>

# Without Supabase only: simulate the inquiry store.
#   MOCK_INQUIRY_MODE=slow    takes about 9 seconds (preview the slow-network message)
#   MOCK_INQUIRY_MODE=error   always fails (preview the failure state)
# MOCK_INQUIRY_MODE=

# Sample testimonials show locally and on Vercel previews, and are hidden in production.
# Force either way with true / false.
# SHOW_SAMPLE_CONTENT=
