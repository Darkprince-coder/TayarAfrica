# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (canonical URLs, sitemap, Open Graph, and links in admin invites)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (leave empty to disable tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Supabase (content, team accounts, booking requests) -----------------------
# Dashboard > Project Settings > API. Without these the site uses the built-in demo content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET, server-only: never share, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (photo uploads from the admin) -----------------------------------
# Dashboard > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SECRET, server-only.
CLOUDINARY_API_SECRET=

# --- Resend (emails: invites, password resets, booking alerts) -----------------
# Added once the domain is verified. Until then the admin gives copy-able links instead.
# RESEND_API_KEY=

# Without Supabase only: simulate the inquiry store.
#   MOCK_INQUIRY_MODE=slow    takes about 9 seconds (preview the slow-network message)
#   MOCK_INQUIRY_MODE=error   always fails (preview the failure state)
# MOCK_INQUIRY_MODE=

# Sample testimonials show locally and on Vercel previews, and are hidden in production.
# Force either way with true / false.
# SHOW_SAMPLE_CONTENT=
